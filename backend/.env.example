# 服务端口
PORT=4000

# JWT
JWT_SECRET=please-change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# 初始管理员（仅首次启动时写入数据库）
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 阿里云 OSS
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 上传到 OSS 的根前缀（可选）
OSS_KEY_PREFIX=zyxf/
# 直传时使用的 endpoint（一般等于 https://<bucket>.<region>.aliyuncs.com）
# 留空则由 OSS_REGION + OSS_BUCKET 自动拼接
OSS_ENDPOINT=

# 前端允许的来源（开发期可写 *）
CORS_ORIGIN=*
