{
  "name": "zyxf-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test --experimental-test-module-mocks --import ./test/setup.js \"test/*.test.js\""
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pinyin-pro": "^3.29.4"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ignore": [
      "**/*.tmp",
      "**/*.TMP",
      "**/*.tmpdir/**",
      "**/*~RF*"
    ]
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
