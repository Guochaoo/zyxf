const __vite__css = "/* SettingsModal — 左右分栏设置的中央弹窗（参照系统设置卡片）。\r\n   遮罩复用菜单的 rb-frost-backdrop 磨砂玻璃；卡片固定尺寸，左右两栏：\r\n   左栏为关闭按钮 + 垂直导航，右栏为标题 + 内容（底部固定操作条）。 */\r\n\r\n.settings-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 210;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 16px;\r\n}\r\n\r\n[data-theme='dark'] .settings-backdrop.rb-frost-backdrop {\r\n  background: rgba(0, 0, 0, 0.46);\r\n}\r\n\r\n/* ---- Card（固定尺寸；视口更小时按 100vw/vh - 32px 收窄） ---- */\r\n.settings-card {\r\n  position: relative; /* 关闭按钮绝对定位到卡片右上角 */\r\n  width: 800px;\r\n  max-width: calc(100vw - 32px);\r\n  height: 580px;\r\n  max-height: calc(100vh - 32px);\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  border-radius: 16px;\r\n  background: var(--surface);\r\n  box-shadow:\r\n    0 1px 2px rgba(0, 0, 0, 0.04),\r\n    0 28px 64px -20px rgba(0, 0, 0, 0.28);\r\n}\r\n\r\n/* ---- 左右布局 ---- */\r\n.settings-layout {\r\n  flex: 1;\r\n  min-height: 0;\r\n  display: flex;\r\n}\r\n\r\n/* ---- 左栏 ----\r\n   底色与资料库左栏同款灰（--app-sidebar，#ECECEE），靠表面色差与右栏白底分区，\r\n   不再画分割细线（无界）；手机端整屏布局下改回透明，见文件末尾的媒体查询。 */\r\n.settings-sidebar {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: 220px;\r\n  flex-shrink: 0;\r\n  padding: 14px 12px;\r\n  background: var(--app-sidebar);\r\n  overflow-y: auto;\r\n}\r\n\r\n/* 左栏标题（桌面端）：与右栏板块标题同一行高与 18px 起点，两栏标题对齐 */\r\n.settings-sidebar-title {\r\n  flex-shrink: 0;\r\n  padding: 4px 10px 12px;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  color: var(--ink);\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n/* 关闭按钮固定在卡片右上角（内容列的标题左对齐，右上角是空白，不会压到文字）；\r\n   手机端整屏布局下改回随标题栏横排，见文件末尾的媒体查询。 */\r\n.settings-sidebar-top {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 10px;\r\n  z-index: 5;\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0;\r\n}\r\n\r\n.settings-close {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 32px;\r\n  height: 32px;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  background: transparent;\r\n  color: var(--ink-2);\r\n  cursor: pointer;\r\n  transition:\r\n    background-color 150ms ease,\r\n    color 150ms ease;\r\n}\r\n\r\n.settings-close:hover {\r\n  background: var(--hover);\r\n  color: var(--ink);\r\n}\r\n\r\n.settings-close:focus-visible {\r\n  outline: none;\r\n  color: var(--ink);\r\n}\r\n\r\n/* 垂直导航 */\r\n.settings-nav {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  /* 条目交互（灰底左栏）：hover 与选中都「往白靠」，只差档位——hover 半档、选中整档。\r\n     原先 hover 是加深（--hover）而选中是变白，两个方向相反，观感不协调。\r\n     暗色下 --surface 比栏底更暗，直接用它会让方向反回来，故改成具名白色叠加。 */\r\n  --settings-chip-hover: color-mix(in srgb, var(--surface) 55%, transparent);\r\n  --settings-chip-active: var(--surface);\r\n}\r\n\r\n[data-theme='dark'] .settings-nav {\r\n  --settings-chip-hover: rgba(255, 255, 255, 0.06);\r\n  --settings-chip-active: rgba(255, 255, 255, 0.12);\r\n}\r\n\r\n.settings-nav-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  width: 100%;\r\n  padding: 9px 10px;\r\n  border: 0;\r\n  border-radius: 10px;\r\n  background: transparent;\r\n  font: inherit;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: var(--ink-2);\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition:\r\n    background-color 150ms ease,\r\n    color 150ms ease;\r\n}\r\n\r\n.settings-nav-item:hover {\r\n  background: var(--settings-chip-hover);\r\n  color: var(--ink);\r\n}\r\n\r\n/* 选中条目：整档白块 + 提拉投影（与统计面板的时间范围 / 指标胶囊同一套语汇：\r\n   组内只有选中的那一项「浮到表面上」，其余靠文字色深浅区分） */\r\n.settings-nav-item--active {\r\n  background: var(--settings-chip-active);\r\n  color: var(--ink);\r\n  box-shadow:\r\n    rgba(23, 23, 23, 0.12) 0px 1px 2px,\r\n    rgba(23, 23, 23, 0.06) 0px 0px 0px 1px;\r\n}\r\n\r\n.settings-nav-item:focus-visible {\r\n  outline: none;\r\n}\r\n\r\n/* 手机端列表行专用的元素（行尾状态图标），桌面端隐藏 */\r\n.settings-nav-arrow {\r\n  display: none;\r\n}\r\n\r\n/* ---- 右栏 ---- */\r\n.settings-content {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n\r\n.settings-content-title {\r\n  padding: 18px 56px 12px 24px; /* 右侧留出角落关闭按钮的位置，长标题也不会压到它 */\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  color: var(--ink);\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n.settings-content-body {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  padding: 4px 24px 20px;\r\n}\r\n\r\n/* 板块内节奏：块间距 20 > 字段间距 14 > 标签到输入框 6，靠间距层级分组，不用色块/描边。\r\n   弹窗卡片本身是白底，字段组再加白底只会多出一圈 16px 假缩进，故不再设底色。 */\r\n.settings-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n/* ---- 智能对话配置 ---- */\r\n/* 配置来源：两个小圆点单选，纵向排列（原生 radio 去外观后自绘，保留键盘/读屏语义） */\r\n.settings-modes {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 10px;\r\n}\r\n\r\n.settings-mode {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  cursor: pointer;\r\n}\r\n\r\n.settings-mode-input {\r\n  appearance: none;\r\n  -webkit-appearance: none;\r\n  width: 16px;\r\n  height: 16px;\r\n  margin: 0;\r\n  border: 0;\r\n  border-radius: 999px;\r\n  background: var(--surface);\r\n  box-shadow: var(--line-strong) 0px 0px 0px 1px;\r\n  cursor: pointer;\r\n  transition: box-shadow 150ms ease;\r\n}\r\n\r\n.settings-mode-input:checked {\r\n  background: radial-gradient(circle, var(--ink) 0 4px, transparent 4px);\r\n  box-shadow: var(--ink) 0px 0px 0px 1px;\r\n}\r\n\r\n/* 选中/未选只换颜色 + 圆点填充，不改字重（改字重会让文字宽度跳动） */\r\n.settings-mode-label {\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: var(--ink-2);\r\n  transition: color 150ms ease;\r\n}\r\n\r\n.settings-mode--active .settings-mode-label {\r\n  color: var(--ink);\r\n}\r\n\r\n/* 字段分组：靠留白分隔（无界理念，不用色块也不用描边）；卡片本身白底，无需底色块 */\r\n.settings-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n\r\n.settings-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.settings-field-label {\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n  color: var(--ink-2);\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n/* 输入框：浅灰底色块本身就是边界（无界），既无描边细线也无聚焦光晕\r\n   （与登录页输入框同款做法）。暗色下改用 --field，避免亮色块刺眼。 */\r\n.settings-input {\r\n  width: 100%;\r\n  padding: 9px 12px;\r\n  border: 0;\r\n  border-radius: 10px;\r\n  background: #f5f5f5;\r\n  font: inherit;\r\n  font-size: 13px;\r\n  color: var(--ink);\r\n  outline: none;\r\n  box-shadow: none;\r\n  transition: background-color 150ms ease;\r\n}\r\n\r\n.settings-input::placeholder {\r\n  color: var(--ink-3);\r\n}\r\n\r\n/* 协议下拉：原生 <select> 的弹出列表由系统绘制（浅色直角、系统高亮），与主题和「无界」\r\n   风格都冲突，因此改成「按钮触发器 + Level 3 浮层」自绘；触发器外观与输入框一致。 */\r\n.settings-select {\r\n  position: relative;\r\n  display: block;\r\n}\r\n\r\n.settings-select-trigger {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  width: 100%;\r\n  padding: 9px 12px;\r\n  border: 0;\r\n  border-radius: 10px;\r\n  background: #f5f5f5;\r\n  font: inherit;\r\n  font-size: 13px;\r\n  color: var(--ink);\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition: background-color 150ms ease;\r\n}\r\n\r\n.settings-select-trigger svg {\r\n  flex-shrink: 0;\r\n  color: var(--ink-3);\r\n}\r\n\r\n.settings-select-value {\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n/* 弹窗内的浮层（DESIGN.md §6 Level 3）：纯投影、无描边、无光晕；语言下拉与协议下拉共用 */\r\n.settings-popover {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 12;\r\n  padding: 6px;\r\n  border-radius: 10px;\r\n  background: var(--surface);\r\n  box-shadow:\r\n    rgba(0, 0, 0, 0.06) 0 4px 10px,\r\n    rgba(0, 0, 0, 0.12) 0 12px 32px;\r\n}\r\n\r\n.settings-popover-option {\r\n  display: flex;\r\n  align-items: center;\r\n  width: 100%;\r\n  padding: 8px 10px;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  background: transparent;\r\n  font: inherit;\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: var(--ink-2);\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition:\r\n    background-color 150ms ease,\r\n    color 150ms ease;\r\n}\r\n\r\n.settings-popover-option:hover {\r\n  background: var(--hover);\r\n  color: var(--ink);\r\n}\r\n\r\n.settings-popover-option--selected {\r\n  color: var(--ink);\r\n}\r\n\r\n/* 暗色下 #f5f5f5 会变成刺眼亮块，改用 token 灰底 */\r\n[data-theme='dark'] .settings-input,\r\n[data-theme='dark'] .settings-select-trigger {\r\n  background: var(--field);\r\n}\r\n\r\n.settings-hint {\r\n  font-size: 12px;\r\n  line-height: 1.55;\r\n  color: var(--ink-3);\r\n}\r\n\r\n/* 校验提示（保存被拦下时出现）+ 常驻说明：合成一块，间距比区块节奏更紧 */\r\n.settings-notes {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n/* 错误用语义红（--red），只给文字，不加描边——设置区输入框一律靠底色表达边界 */\r\n.settings-error {\r\n  font-size: 12px;\r\n  line-height: 1.55;\r\n  color: var(--red);\r\n}\r\n\r\n/* 必填项缺失：标红该字段的标签（这是最轻的信号，仍然不画描边） */\r\n.settings-field--invalid .settings-field-label {\r\n  color: var(--red);\r\n}\r\n\r\n/* ---- 按钮组（按钮本体复用站点 rb-btn-dark / rb-btn-ghost）----\r\n   固定在右栏右下角：作为 .settings-content 的底部条（不在滚动区内，内容再长也不会被推走）。 */\r\n.settings-actions {\r\n  flex-shrink: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n  padding: 12px 24px 18px;\r\n}\r\n\r\n/* 次级按钮在本条里跟主按钮配对展示，圆角对齐到 rb-btn-dark 的 14px（其他页面的\r\n   ghost 仍是 6px，属站点既有规范，不在此处统一） */\r\n.settings-actions .rb-btn-ghost {\r\n  border-radius: 14px;\r\n}\r\n\r\n/* ---- 账户信息 ---- */\r\n.settings-rows {\r\n  margin: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.settings-row {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 14px 2px;\r\n  border-bottom: 1px solid var(--line);\r\n}\r\n\r\n.settings-row:last-child {\r\n  border-bottom: 0;\r\n}\r\n\r\n.settings-row dt {\r\n  font-size: 14px;\r\n  color: var(--ink-2);\r\n}\r\n\r\n.settings-row dd {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: var(--ink);\r\n}\r\n\r\n.settings-empty {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  padding: 40px 0;\r\n  color: var(--ink-3);\r\n}\r\n\r\n.settings-empty-title {\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  color: var(--ink-2);\r\n}\r\n\r\n.settings-empty-sub {\r\n  font-size: 12px;\r\n}\r\n\r\n/* ---- 外观/偏好 ---- */\r\n.settings-appearance {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n\r\n.settings-group-title {\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: var(--ink);\r\n  margin: 0;\r\n}\r\n\r\n.settings-lang-group-title {\r\n  margin-top: 20px;\r\n}\r\n\r\n/* 三档主题卡片横排 */\r\n.settings-theme-cards {\r\n  display: flex;\r\n  gap: 12px;\r\n}\r\n\r\n.settings-theme-card {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 0;\r\n  border: 0;\r\n  background: transparent;\r\n  font: inherit;\r\n  cursor: pointer;\r\n}\r\n\r\n.settings-theme-card:focus-visible {\r\n  outline: none;\r\n}\r\n\r\n/* 预览色块（swatch） */\r\n.settings-theme-swatch {\r\n  width: 100%;\r\n  height: 92px;\r\n  border-radius: 12px;\r\n  border: 2px solid transparent;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  overflow: hidden;\r\n  transition:\r\n    border-color 150ms ease,\r\n    box-shadow 150ms ease;\r\n}\r\n\r\n.settings-theme-swatch--light {\r\n  background: #ffffff;\r\n  border-color: #e6e6e6;\r\n}\r\n\r\n.settings-theme-swatch--system {\r\n  background:\r\n    linear-gradient(to right, #ffffff 0 50%, #161616 50% 100%);\r\n  border-color: #e6e6e6;\r\n}\r\n\r\n.settings-theme-swatch--dark {\r\n  background: #161616;\r\n  border-color: #2a2a2a;\r\n}\r\n\r\n.settings-theme-swatch-brand {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.02em;\r\n  color: #171717;\r\n  background: rgba(255, 255, 255, 0.92);\r\n  padding: 5px 12px;\r\n  border-radius: 999px;\r\n}\r\n\r\n.settings-theme-swatch--dark .settings-theme-swatch-brand {\r\n  color: #ffffff;\r\n  background: rgba(0, 0, 0, 0.72);\r\n}\r\n\r\n.settings-theme-card--active .settings-theme-swatch {\r\n  border-color: #0f6cff;\r\n  box-shadow: 0 0 0 1px #0f6cff;\r\n}\r\n\r\n.settings-theme-card-label {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: var(--ink);\r\n}\r\n\r\n/* 字体和语言：可展开下拉 */\r\n.settings-lang {\r\n  position: relative;\r\n}\r\n\r\n.settings-lang-row {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  width: 100%;\r\n  padding: 12px 14px;\r\n  border: 0;\r\n  border-radius: 12px;\r\n  background: var(--field);\r\n  font: inherit;\r\n  cursor: pointer;\r\n  transition:\r\n    background-color 150ms ease,\r\n    color 150ms ease;\r\n}\r\n\r\n.settings-lang-row:hover {\r\n  background: var(--hover);\r\n}\r\n\r\n.settings-lang-label {\r\n  font-size: 14px;\r\n  color: var(--ink);\r\n}\r\n\r\n.settings-lang-value {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  font-size: 14px;\r\n  color: var(--ink-2);\r\n}\r\n\r\n/* 语言下拉与协议下拉共用 .settings-popover / .settings-popover-option 样式 */\r\n\r\n/* ---- 窄屏（≤640px）：整屏页面，视觉仿原生 App 设置页 ——\r\n   灰底页面 + 白色圆角分组卡片；顶部条是「左侧圆形按钮 + 居中标题」，\r\n   导航变成一张白卡片里的列表行，区块内容各成一张卡片，底部操作条也是一张卡片。 ---- */\r\n@media (max-width: 640px) {\r\n  .settings-backdrop {\r\n    padding: 0;\r\n  }\r\n\r\n  .settings-card {\r\n    width: 100%;\r\n    height: 100vh;\r\n    height: 100dvh; /* 避开移动端浏览器地址栏（与 NoticeModal / Preview 同口径） */\r\n    max-width: none;\r\n    max-height: none;\r\n    border-radius: 0;\r\n    box-shadow: none;\r\n    background: var(--page); /* 页面底色转灰，分区靠白色卡片表达 */\r\n  }\r\n\r\n  .settings-layout {\r\n    flex-direction: column;\r\n  }\r\n\r\n  /* 顶部条 + 导航：包在白卡片外的顶部区域，导航自己是一张白卡片。\r\n     行高 36px + 标题在其中居中 → 文字上沿到页顶 8px；\r\n     行与列表卡片之间留 6px，于是文字下边缘到列表顶端 14px。\r\n     index.html 没开 viewport-fit=cover，故不需要 env(safe-area-inset-*)。 */\r\n  .settings-sidebar {\r\n    flex-direction: row;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    gap: 6px;\r\n    width: auto;\r\n    padding: 0 12px;\r\n    background: transparent;\r\n    overflow-y: visible; /* 侧栏改成顶部条后不再单独滚动 */\r\n  }\r\n\r\n  /* 整行：左侧圆形关闭按钮（绝对定位）+ 居中标题。\r\n     必须清掉基类的 top/right —— 那是桌面端把关闭按钮钉到卡片右上角用的绝对定位偏移，\r\n     这里 position 换成 relative 后它们会变成「相对偏移」，把整行推下 10px、拉左 10px。 */\r\n  .settings-sidebar-top {\r\n    position: relative;\r\n    top: auto;\r\n    right: auto;\r\n    flex: 1 1 100%;\r\n    justify-content: center;\r\n    min-height: 36px;\r\n    padding: 0;\r\n  }\r\n\r\n  .settings-mobile-title {\r\n    font-size: 17px;\r\n    font-weight: 600;\r\n    line-height: 1.2; /* 固定行高，避免跟随系统字体把行撑高 */\r\n    color: var(--ink);\r\n  }\r\n\r\n  /* 圆底比点击行小一档（32px，行内居中），视觉上不压到页顶也不贴住列表卡片 */\r\n  .settings-close {\r\n    position: absolute;\r\n    left: 0;\r\n    top: 50%;\r\n    width: 32px;\r\n    height: 32px;\r\n    margin-top: -16px;\r\n    border-radius: 999px;\r\n    background: var(--hover);\r\n    color: var(--ink);\r\n  }\r\n\r\n  /* 导航：白卡片 + 列表行（图标 + 文案 + 右侧状态图标） */\r\n  .settings-nav,\r\n  [data-theme='dark'] .settings-nav {\r\n    flex: 1 1 100%;\r\n    flex-direction: column;\r\n    gap: 0;\r\n    padding: 4px;\r\n    border-radius: 16px;\r\n    background: var(--surface);\r\n    overflow: visible;\r\n    /* 条目已经坐在白卡片里：hover / 选中都回到浅灰块（白块 + 投影在白底上反而看不出边界） */\r\n    --settings-chip-hover: var(--hover);\r\n    --settings-chip-active: var(--hover);\r\n  }\r\n\r\n  .settings-nav-item--active {\r\n    box-shadow: none;\r\n  }\r\n\r\n  .settings-nav-item {\r\n    width: 100%;\r\n    gap: 12px;\r\n    padding: 13px 12px;\r\n    border-radius: 12px;\r\n    font-size: 15px;\r\n  }\r\n\r\n  .settings-nav-item svg:first-child {\r\n    width: 20px;\r\n    height: 20px;\r\n    color: var(--ink);\r\n  }\r\n\r\n  .settings-nav-arrow {\r\n    display: block;\r\n    margin-left: auto;\r\n    color: var(--ink-3);\r\n  }\r\n\r\n  /* 内容区（二级页面）：板块名已在顶部条上，这里不再重复标题 */\r\n  .settings-content {\r\n    background: transparent;\r\n  }\r\n\r\n  .settings-content-body {\r\n    padding: 10px 12px 12px;\r\n  }\r\n\r\n  /* 每个板块 = 一张白卡片 */\r\n  .settings-section {\r\n    gap: 18px;\r\n    padding: 14px;\r\n    border-radius: 16px;\r\n    background: var(--surface);\r\n  }\r\n\r\n  /* 底部操作条：同样是一张白卡片，钉在页面底部 */\r\n  .settings-actions {\r\n    margin: 0 12px 12px;\r\n    padding: 12px;\r\n    border-radius: 16px;\r\n    background: var(--surface);\r\n  }\r\n}\r\n\r\n"
