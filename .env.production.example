# ============================================================
# 生产环境变量 — 放在服务器的 /opt/zyxf/.env 文件中
# docker compose 会自动读取这个文件
# ⚠️ 请把下方的占位符替换为真实值！
# ============================================================

# JWT（⚠️ 务必改为强随机字符串）
JWT_SECRET=请替换为随机字符串
JWT_EXPIRES_IN=7d

# 管理员账号
ADMIN_USER=admin
ADMIN_PASSWORD=请替换为管理员密码

# 阿里云 OSS
OSS_REGION=oss-cn-beijing
OSS_BUCKET=请替换为bucket名称
OSS_ACCESS_KEY_ID=请替换为AccessKeyId
OSS_ACCESS_KEY_SECRET=请替换为AccessKeySecret
OSS_KEY_PREFIX=zyxf/
# 自定义域名（WebOffice 预览必需）
OSS_ENDPOINT=https://你的自定义域名

# 前端访问来源
CORS_ORIGIN=https://你的自定义域名

# IMM 预览样式（可选，留空使用默认值）
IMM_STYLE=

# HTTP端口（默认80）
HTTP_PORT=80
