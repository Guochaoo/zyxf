# ============================================================
# 唯一的环境变量文件：复制为仓库根目录的 .env 后填写真实值
#   cp .env.example .env
# docker compose（服务器部署）与本地开发共用这一个文件。
# ⚠️ .env 已被 .gitignore 忽略，绝不会提交到仓库。
# ============================================================

# 对外暴露的 HTTP 端口（前端 nginx；80 = http 默认）
HTTP_PORT=80

# 后端内部端口（一般保持 4000）
PORT=4000

# JWT 密钥 — 生产环境必须设置为 32+ 字节随机串，否则服务拒绝启动
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=please-change-me-to-a-random-32-byte-string
JWT_EXPIRES_IN=7d

# 初始管理员（仅首次启动写入数据库）— 生产环境必须设置为强密码（12+ 位）
ADMIN_USER=admin
ADMIN_PASSWORD=please-change-me

# 跨域来源：生产环境填具体域名（例如 https://your-site.com）；
# 同源部署（nginx 反代）可留空
CORS_ORIGIN=

# 阿里云 OSS
OSS_REGION=oss-cn-beijing
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 上传到 OSS 的根前缀（可选）
OSS_KEY_PREFIX=zyxf/
# 直传 endpoint（一般 = https://<bucket>.<region>.aliyuncs.com，可留空自动拼接）
OSS_ENDPOINT=

# IMM 文档预览样式（可选）：已保存样式名（如 zyxfyulan）或内联参数；
# 留空用安全默认（仅预览，不允许导出/打印）
IMM_STYLE=
