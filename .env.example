# 复制为 .env 后修改值（docker-compose 会自动读取）
#   cp .env.example .env

# 对外暴露的端口（80 = http 默认；如果 80 被占用可改成 8080 等）
HTTP_PORT=80

# JWT
JWT_SECRET=please-change-me-to-a-random-32-byte-string
JWT_EXPIRES_IN=7d

# 初始管理员（首次启动写入数据库）
ADMIN_USER=admin
ADMIN_PASSWORD=please-change-me

# 仅当跨域访问后端时需要；同源（前端 nginx 代理）时可保留 *
CORS_ORIGIN=*

# 阿里云 OSS
OSS_REGION=oss-cn-beijing
OSS_BUCKET=xjtu-zyxf
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_KEY_PREFIX=zyxf/
OSS_ENDPOINT=
