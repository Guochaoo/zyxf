# 复制为 .env 后修改值（docker-compose 会自动读取）
#   cp .env.example .env

# 对外暴露的端口（80 = http 默认；如果 80 被占用可改成 8080 等）
HTTP_PORT=80

# 运行环境（生产环境务必设置为 production；否则安全启动校验不会触发）
NODE_ENV=production

# JWT — 生产环境必须设置；未设置或为 dev-secret 时,服务将拒绝启动
# 推荐用 32+ 字节随机串：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=please-change-me-to-a-random-32-byte-string
JWT_EXPIRES_IN=7d

# 初始管理员（首次启动写入数据库）— 生产环境必须设置
ADMIN_USER=admin
ADMIN_PASSWORD=please-change-me

# 跨域：生产环境务必填具体域名(例如 https://your-site.com),
# 留空或 * 会触发警告。同源(前端 nginx 代理后端)可留空。
CORS_ORIGIN=

# 阿里云 OSS
OSS_REGION=oss-cn-beijing
OSS_BUCKET=xjtu-zyxf
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_KEY_PREFIX=zyxf/
OSS_ENDPOINT=
