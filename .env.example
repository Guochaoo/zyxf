# ============================================================
# 唯一的环境变量文件：复制为仓库根目录的 .env 后填写真实值
#   cp .env.example .env
# 本地开发与生产部署共用；服务器部署见 docs/DEPLOY.md。
# ⚠️ .env 已被 .gitignore 忽略，绝不会提交到仓库。
# ============================================================

# 后端内部端口（一般保持 4000）
PORT=4000
# 后端监听地址。默认 127.0.0.1：后端始终位于 nginx / Vite 代理之后，绑回环可
# 确保外部无法直连，也就无法伪造 X-Forwarded-For 绕过限流。确需外部直连才设 0.0.0.0。
HOST=127.0.0.1

# JWT 密钥 — 生产环境必须设置为 32+ 字节随机串，否则服务拒绝启动
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=please-change-me-to-a-random-32-byte-string
JWT_EXPIRES_IN=7d

# 管理员账号（.env 为唯一权威来源：每次启动同步密码/角色）— 生产环境必须设置为强密码（12+ 位）
ADMIN_USER=admin
ADMIN_PASSWORD=please-change-me

# 跨域来源：生产环境填具体域名（例如 https://your-site.com）；
# 同源部署（nginx 反代）可留空
CORS_ORIGIN=
# 开发模式下允许的前端来源（留空则用默认 http://localhost:5173）；仅本地开发用
ALLOWED_DEV_ORIGIN=

# 阿里云 OSS
OSS_REGION=oss-cn-beijing
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 上传到 OSS 的根前缀（可选）
OSS_KEY_PREFIX=zyxf/
# 直传 endpoint（一般 = https://<bucket>.<region>.aliyuncs.com，可留空自动拼接）
OSS_ENDPOINT=

# IMM 文档预览项目名（可选）：OSS 控制台绑定 IMM 时创建的项目名，默认 zyxf；
# 项目名不同才需要设置，未绑定时预览接口返回 502（其余功能不受影响）
IMM_PROJECT=

# ---- 用户注册邮箱验证码（阿里云邮件推送 DirectMail，可选）----
# 三项都填写才启用注册功能（发信地址需已在 DirectMail 控制台验证），
# 留空则注册发码接口返回 503「邮件功能未配置」，其余功能不受影响。
DM_ACCESS_KEY_ID=
DM_ACCESS_KEY_SECRET=
# 发信地址，例如 no-reply@zyxf.top
DM_ACCOUNT_NAME=
# 发件人显示名（可选，默认「仲英学辅」）
DM_FROM_ALIAS=

# ---- AI 资料助手（可选）----
# 三个变量都填写才启用 AI 对话（OpenAI 兼容接口），留空则前端显示「AI 功能未配置」。
# 例（智谱 GLM）：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.6
# 例（DeepSeek）：LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- 数据保留（可选）----
# 下载日志（含 ip/ua）保留天数，默认 400（略大于仪表盘热力图的近一年窗口）。
DOWNLOAD_LOG_RETENTION_DAYS=
