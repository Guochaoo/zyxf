[Unit]
Description=zyxf 数据库备份（SQLite 快照 → OSS）
# 备份要等网络可用；After=network.target 不够，oneshot 可能在 DNS 就绪前就跑。
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www
WorkingDirectory=/opt/zyxf/backend
# 脚本自己会读 /opt/zyxf/.env，不需要外部注入；给个合理的超时避免钉死。
TimeoutStartSec=300
ExecStart=/usr/bin/node scripts/backup-db.mjs

# --- 加固（issue #93，与主服务同一套口径）---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 需要读 data.db（同目录）并在 PrivateTmp 里写快照临时文件，因此只放行数据目录。
ReadWritePaths=/opt/zyxf/backend

[Install]
WantedBy=multi-user.target
